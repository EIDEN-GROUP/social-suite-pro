# =============================================================================
# SMimulator environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---- Supabase ---------------------------------------------------------------
# Project URL and keys from the Supabase dashboard -> Project Settings -> API.
# The publishable (anon) key is browser-safe. The service-role key is SECRET and
# must only ever be used by server functions (it bypasses RLS).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres connection string (session pooler URI) used by
# `bun scripts/apply-migration.ts <file>.sql`.
SUPABASE_DB_URL=

# ---- Composio (social connections + publishing) -----------------------------
# API key from https://app.composio.dev -> Settings -> API keys.
# SECRET - server-side only. Never expose to the browser.
COMPOSIO_API_KEY=

# Webhook signing secret. Set the same value as the project webhook subscription
# in Composio (Settings -> Webhooks). Used by /api/composio/webhook to verify
# inbound trigger events. SECRET.
COMPOSIO_WEBHOOK_SECRET=

# Auth config IDs, one per toolkit ("public" app). Create these in the Composio
# dashboard (Auth Configs) or let the app create managed auth configs on first
# connect (then they are stored in the `integration_configs` table instead).
# Optional - DB values take precedence when present.
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_TIKTOK=
COMPOSIO_AUTH_CONFIG_FACEBOOK=
COMPOSIO_AUTH_CONFIG_TWITTER=
COMPOSIO_AUTH_CONFIG_LINKEDIN=

# Pinned toolkit versions (optional). Composio requires an explicit version for
# manual tool execution. Map toolkit slug -> version, e.g.
#   COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=20250909_00
COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=
COMPOSIO_TOOLKIT_VERSION_TIKTOK=
COMPOSIO_TOOLKIT_VERSION_FACEBOOK=
COMPOSIO_TOOLKIT_VERSION_TWITTER=
COMPOSIO_TOOLKIT_VERSION_LINKEDIN=

# ---- White-label OAuth (optional) -------------------------------------------
# Use the in-app setup instead of env: Admin -> Auth setup. It creates a custom
# auth config per platform from your own OAuth app and stores only its id,
# redirect URI and scopes in `integration_configs`. Client secrets go straight
# to Composio and are never stored here.
#
# Register this redirect URI in each provider's OAuth app:
#   https://backend.composio.dev/api/v3/toolkits/auth/callback
#
# Step-by-step provider notes: docs/white-label-auth.md

# ---- App / infrastructure ---------------------------------------------------
# Public base URL of the deployment, used to build the Composio OAuth callback
# URL and notification links. e.g. https://studio.example.com
APP_BASE_URL=

# Shared secret for the scheduled publishing runner (/api/cron/publish).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`. SECRET.
CRON_SECRET=
