# =============================================================================
# Simulator environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---- Supabase ---------------------------------------------------------------
# Project URL and keys from the Supabase dashboard -> Project Settings -> API.
# The publishable (anon) key is browser-safe. The service-role key is SECRET and
# must only ever be used by server functions (it bypasses RLS).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres connection string (session pooler URI) used by
# `bun scripts/apply-migration.ts <file>.sql`.
SUPABASE_DB_URL=

# ---- Social connections ------------------------------------------------------
# Integration API key (server-side only). Create it in the provider dashboard.
COMPOSIO_API_KEY=

# Webhook signing secret for inbound trigger events at /api/composio/webhook.
# SECRET - server-side only.
COMPOSIO_WEBHOOK_SECRET=

# Auth config ids, one per toolkit. Created in the provider dashboard, or left
# blank so the app creates a managed config on first connect (stored in the
# `integration_configs` table).
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_TIKTOK=
COMPOSIO_AUTH_CONFIG_FACEBOOK=
COMPOSIO_AUTH_CONFIG_TWITTER=
COMPOSIO_AUTH_CONFIG_LINKEDIN=

# Pinned toolkit versions (optional). The provider requires an explicit version
# for manual tool execution. Map toolkit slug -> version, e.g.
#   COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=20250909_00
COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=
COMPOSIO_TOOLKIT_VERSION_TIKTOK=
COMPOSIO_TOOLKIT_VERSION_FACEBOOK=
COMPOSIO_TOOLKIT_VERSION_TWITTER=
COMPOSIO_TOOLKIT_VERSION_LINKEDIN=

# ---- Connect interface -------------------------------------------------------
# Accounts are connected through our own UI (Admin -> Connect); the integration
# provider is the backend. See docs/white-label-auth.md.

# ---- App / infrastructure ---------------------------------------------------
# Public base URL of the deployment, used to build the OAuth callback URL and
# notification links. e.g. https://studio.example.com
APP_BASE_URL=

# Shared secret for the scheduled publishing runner (/api/cron/publish).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`. SECRET.
CRON_SECRET=
